# Copy to .env. Every value here is already the default, so an unedited copy
# works; change one only when your setup differs.

RECALL_DATA=./data
RECALL_WORK=./work

RECALL_PG_DSN=postgresql://recall:recall@127.0.0.1:5433/recall

RECALL_EMBED_URL=http://127.0.0.1:8080/v1/embeddings
RECALL_EMBED_MODEL=embeddings
# Must match the model that is actually running. A mismatch is a setup
# fault, not bad data, so it stops the run instead of dropping chunks.
RECALL_EMBED_DIMS=1024
# Must match the server's -ub. A request larger than this is rejected, and
# recall calibrates its chunk budget from it.
RECALL_EMBED_CONTEXT=8192

# OPTIONAL. Indexing and search never use this. Set it only to have recall
# write prose answers, and point it at any OpenAI-compatible endpoint you
# already run: llama.cpp, Ollama, vLLM, LM Studio. See docs/answering.md.
# RECALL_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
# RECALL_CHAT_MODEL=llama3.1
# Your name. Message sources label your lines "me:", which binds the
# subject to you; the prompt relabels them with this and storage never
# changes. See docs/answering.md.
# RECALL_USER_LABEL=

# Only needed for `recall serve`. It refuses to start without one, and it
# fails closed: an empty token accepts nothing.
RECALL_API_TOKEN=
RECALL_API_BIND=127.0.0.1
RECALL_API_PORT=8099

# Swap the embedding model. Any GGUF on Hugging Face works. Set
# RECALL_EMBED_DIMS to the new model's dimension, then re-create the chunk
# table: its vector column is fixed at the old size.
# RECALL_EMBED_HF=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
