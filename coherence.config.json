{
  "name": "recall",
  "language": "python",
  "ignore": ["node_modules", ".venv", "__pycache__", ".pytest_cache", "recall.egg-info", "data", "work", "docs"],
  "test": ".venv/bin/python -m pytest -q -k {filter}",
  "testMatch": "[1-9][0-9]* passed",
  "testFilterForm": "pytest",
  "testJson": ".venv/bin/python -m pytest -q -k {filter} --junitxml={out}"
}
